# URL base da API Laravel (sem barra final)
API_URL=http://localhost:8000

# Slug da campanha ativa na API
CAMPAIGN_SLUG=templo

# Token de proxy (mesmo valor de CAMPANHA_PROXY_TOKEN na API)
CAMPAIGN_PROXY_TOKEN=

# URL pública do site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Exibe o selo "Modo de teste" no resumo da doação (ambiente sandbox do Asaas)
NEXT_PUBLIC_PAYMENTS_SANDBOX=true
